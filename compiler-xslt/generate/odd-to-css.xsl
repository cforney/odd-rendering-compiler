<?xml version="1.0" encoding="UTF-8"?>
<!--
  odd-to-css.xsl — the "generate" step for edition.css, in XSLT.

  Emits the design tokens named by $tokens, the source renditions of <tagsDecl>
  as .r-<id> rules, each model's <outputRendition> as a rule on the class the
  renderers give the element for that model (see odd-model.xsl), then the
  renderers' notes (../../runtime/notes.css). The
  renderers evaluate the predicates, so the CSS needs none. A custom property the
  ODD's CSS reads but nothing defines is reported. The XSLT counterpart of
  odd-to-css.mjs.

  Run:  saxon -s:../examples/tei_simler.odd -xsl:generate/odd-to-css.xsl
              -o:output/edition.css tokens=simler-tokens.css
  The `tokens` parameter is a CSS file, resolved next to the ODD.
-->
<xsl:stylesheet version="3.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:pm="urn:x-poc:pm"
  exclude-result-prefixes="#all">

  <xsl:include href="odd-model.xsl"/>

  <xsl:output method="text" encoding="UTF-8"/>

  <xsl:param name="tokens" as="xs:string?"/>

  <xsl:template match="/">
    <xsl:variable name="odd" select="pm:odd(/)"/>
    <xsl:variable name="tokens-css" select="for $t in $tokens return replace(unparsed-text(resolve-uri($t, base-uri(/))), '^\s+|\s+$', '')"/>
    <xsl:variable name="odd-css" as="xs:string*" select="
      $odd/pm:rendition ! ('.r-' || @id || ' { ' || @css || ' }'),
      $odd/pm:spec//pm:rule ! (@selector || ' { ' || @css || ' }')"/>

    <!-- Custom properties are defined by the tokens, by the ODD's CSS, and by the params named after them. -->
    <xsl:variable name="defined" select="
      analyze-string(string-join(($tokens-css, $odd-css), '&#10;'), '(--[\w\-]+)\s*:')//*:group[@nr = 1],
      $odd//pm:param/@name"/>
    <xsl:for-each select="distinct-values(analyze-string(string-join($odd-css, '&#10;'), 'var\(\s*(--[\w\-]+)')//*:group[@nr = 1])[not(. = $defined)]">
      <xsl:message select="'[odd-to-css.xsl] ⚠ var(' || . || ') is defined nowhere' || (if ($tokens) then '' else ' (no tokens)')"/>
    </xsl:for-each>

    <xsl:value-of select="'/* edition.css — generated by odd-to-css.xsl; edit the ODD, not this file. */&#10;'"/>
    <xsl:value-of select="($tokens-css, '.pm-block { display: block; }', $odd-css,
      replace(unparsed-text('../../runtime/notes.css'), '^\s+|\s+$', '')) ! (. || '&#10;')" separator=""/>
  </xsl:template>

</xsl:stylesheet>
