<?xml version="1.0" encoding="UTF-8"?>
<!--
  odd-to-css.xsl — the "generate" step for edition.css, in XSLT.

  Emits the source renditions of <tagsDecl> as .r-<id> rules, then each
  model's <outputRendition> as a rule on the class the renderers give the
  element for that model (see odd-model.xsl). The renderers evaluate the
  predicates, so the CSS needs none. The XSLT counterpart of odd-to-css.mjs.

  Run:  saxon -s:../examples/tei_simler.odd -xsl:generate/odd-to-css.xsl
              -o:output/edition.css
-->
<xsl:stylesheet version="3.0"
  xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
  xmlns:pm="urn:x-poc:pm"
  exclude-result-prefixes="#all">

  <xsl:include href="odd-model.xsl"/>

  <xsl:output method="text" encoding="UTF-8"/>

  <xsl:template match="/">
    <xsl:variable name="odd" select="pm:odd(/)"/>
    <xsl:value-of select="'/* edition.css — generated by odd-to-css.xsl; edit the ODD, not this file. */&#10;'"/>
    <xsl:value-of select="'.pm-block { display: block; }&#10;'"/>
    <xsl:for-each select="$odd/pm:rendition">
      <xsl:value-of select="'.r-' || @id || ' { ' || @css || ' }&#10;'"/>
    </xsl:for-each>
    <xsl:for-each select="$odd/pm:spec//pm:rule">
      <xsl:value-of select="@selector || ' { ' || @css || ' }&#10;'"/>
    </xsl:for-each>
  </xsl:template>

</xsl:stylesheet>
