{
  "name": "odd-rendering-compiler",
  "version": "0.3.0",
  "description": "Build-time pipeline: TEI ODD Processing Model → CSS, XSLT, unified/xast handlers, and CETEIcean behaviours — with end-to-end HTML rendering for static editions",
  "type": "module",
  "main": "odd-to-css.mjs",
  "bin": {
    "odd-render": "odd-render.mjs"
  },
  "scripts": {
    "build": "node odd-to-css.mjs --odd ../examples/tei_simler.odd --tokens ../examples/simler-tokens.css --out output",
    "build:xslt": "node odd-to-xslt.mjs --odd ../examples/tei_simler.odd --out output",
    "build:unified": "node odd-to-unified.mjs --odd ../examples/tei_simler.odd --out output --strict",
    "build:ceteicean": "node odd-to-ceteicean.mjs --odd ../examples/tei_simler.odd --tei \"../examples/simler-*.xml\" --css output/edition.css --out output/ceteicean --strict",
    "build:all": "npm run build && npm run build:xslt && npm run build:unified && npm run build:ceteicean",
    "render:xslt": "node render-xslt.mjs --xsl output/edition.xsl --tei \"../examples/simler-*.xml\" --css output/edition.css --out output/xslt",
    "render:unified": "node render-unified.mjs --handlers output/tei-handlers.mjs --tei \"../examples/simler-*.xml\" --css output/edition.css --out output/unified",
    "render:interactive": "node render-unified-interactive.mjs --handlers output/tei-handlers.mjs --tei \"../examples/simler-*.xml\" --css output/edition.css --out output/unified-interactive",
    "render:islands": "node render-unified-islands.mjs --handlers output/tei-handlers.mjs --tei \"../examples/simler-*.xml\" --css output/edition.css --out output/unified-islands",
    "render:ceteicean": "npm run build:ceteicean",
    "render:plain": "node render-plain.mjs --handlers output/tei-handlers.mjs --tei \"../examples/simler-*.xml\" --lang de --out output/plain",
    "render:json": "node render-json.mjs --odd ../examples/tei_simler.odd --tei \"../examples/simler-*.xml\" --out output/json --strict",
    "render:search": "node search-index.mjs --records output/plain/records.json --pages ../unified/ --out output/search",
    "render:all": "npm run render:xslt && npm run render:unified && npm run render:interactive && npm run render:islands && npm run render:plain && npm run render:search && npm run render:json",
    "coverage": "node coverage.mjs --odd ../examples/tei_simler.odd --records output/json --out output/coverage",
    "findings": "node findings.mjs --odd ../examples/tei_simler.odd --tei \"../examples/simler-*.xml\" --tokens ../examples/simler-tokens.css --out output/findings",
    "demo": "npm run build && npm run build:unified && npm run render:unified && npm run render:interactive",
    "build:simpleprint": "node odd-to-css.mjs --odd ../examples/tei_simplePrint.odd --out output/simpleprint",
    "build:extension": "node odd-to-css.mjs --odd ../examples/extensions/nested-pb/tei_simler-nested-pb.odd --tokens ../examples/simler-tokens.css --out output/nested-pb && node odd-to-unified.mjs --odd ../examples/extensions/nested-pb/tei_simler-nested-pb.odd --out output/nested-pb --strict",
    "render:extension": "node render-unified.mjs --handlers output/nested-pb/tei-handlers.mjs --tei ../examples/simler-psalmen.xml --css output/nested-pb/edition.css --out output/nested-pb",
    "build:demo": "node ../demo/build-demo.mjs",
    "check:demo": "node --experimental-websocket ../demo/check-demo.mjs",
    "sync:odd": "node ../examples/sync-odd.mjs",
    "test": "node --test",
    "typecheck": "tsc"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@rgrove/parse-xml": "4.2.0"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  },
  "license": "BSD-2-Clause",
  "author": "Christian Forney",
  "optionalDependencies": {
    "pagefind": "1.5.2"
  }
}
