  <text>
  <body>
  <div n="1">
                <pb n="537" facs="4049736"/>
                <div n="2" xml:id="n213">
                    <head rendition="#b #c">141. <hi rendition="#aq #g">DOROTHEA</hi><hi
                            rendition="#aq">,</hi><lb/> oder <lb/>Anbindungs-Gesang: <lb/>Auf
                        <lb/>den 6. tag Hornungs <lb/>1659.</head>
                    <lb/>
                    <p rendition="#c">In der weise: Galathee laß mich preisen.</p>
                    <lb/>
                    <lg type="poem">
                        <lg n="1">
                            <l><hi rendition="#in">D</hi>OROTHEA/ laß mich preisen</l>
                            <lb/>
                            <l rendition="#et">deinen schönen Namen Heut/</l>
                            <lb/>
                            <l>auß demselben dir zuweisen</l>
                            <lb/>
                            <pb n="538" facs="4049737"/>
                            <l rendition="#et">was mir mein gemu&#x364;ht erfreut/</l>
                            <lb/>
                            <l n="5" rendition="#et2">Eine freye Gottes-gab</l>
                            <lb/>
                            <l rendition="#et2">heissest du/ und bist vorab</l>
                            <lb/>
                            <l>mir geschänket von dem HERREN/</l>
                            <lb/>
                            <l><choice><sic>desse</sic><corr>dessen</corr></choice> Nam bekannt ist ferren.</l>
                        </lg>
                        <lb/>
                        <lg n="2">
                            <head rendition="#c">2.</head>
                            <lb/>
                            <l>Heut/ nach unsern Landesbräuchen/</l>
                            <lb/>
                            <l n="10" rendition="#et">flochte meine treue Hand/</l>
                            <lb/>
                            <l>auß gemahlten Blumensträuchen/</l>
                            <lb/>
                            <l rendition="#et">meiner Liebsten dises Band:</l>
                            <lb/>
                            <l rendition="#et2">daß sie mit verknüpfet sey/</l>
                            <lb/>
                            <l rendition="#et2">biß sie sich wird lösen frey/</l>
                            <lb/>
                            <l n="15">mit beliebter Liebes-gabe/</l>
                            <lb/>
                            <l>die mein junges Hertz erlabe.</l>
                        </lg>
                        <lb/>
                        <lg n="3">
                            <head rendition="#c">3.</head>
                            <lb/>
                            <l>Mancher bindet nur im schertzen</l>
                            <lb/>
                            <l rendition="#et">die und die auf disen Tag:</l>
                            <lb/>
                            <l>aber Ich/ mit stätem Hertzen/</l>
                            <lb/>
                            <l n="20" rendition="#et">binde dich/ so vest ich mag/</l>
                            <lb/>
                            <l rendition="#et2">Wünsch’ und bitte Gott dabey</l>
                            <lb/>
                            <l rendition="#et2">daß sich diser Tag verneu</l>
                            <lb/>
                            <l>vilbeliebte jahr/ in freuden/</l>
                            <lb/>
                            <l>mit gesundheit unser Beiden.</l>
                        </lg>
                        <lb/>
                        <lg n="4">
                            <head rendition="#c">4.</head>
                            <lb/>
                            <l n="25">Liebste/ laß es dir belieben</l>
                            <lb/>
                            <l rendition="#et">wie es ist von mir gemeint:</l>
                            <lb/>
                            <l>werden wir gleich oft vertriben/</l>
                            <lb/>
                            <l rendition="#et">seind wir doch/ d<choice><sic>n</sic><corr>u</corr></choice>rch Tre<choice><sic>n</sic><corr>u</corr></choice>/ vereint:</l>
                            <lb/>
                            <l rendition="#et2">Bleib nur immer wie du bist/</l>
                            <lb/>
                            <l n="30" rendition="#et2">dan/ in einer kurtzen frist/</l>
                            <lb/>
                            <l>werden wir zusamen kommen/</l>
                            <lb/>
                            <l>und dem scheyden seyn entnommen.</l>
                        </lg>
                        <lb/>
                        <lg n="5">
                            <head rendition="#c">5.</head>
                            <lb/>
                            <l>Zwing/ Apollo/ deine
                                Säiten/</l>
                            <lb/>
                            <l rendition="#et">daß sie/ durch geschärfften klang/</l>
                            <lb/>
                            <l n="35">meiner Liebsten Lob außbräiten:</l>
                            <lb/>
                            <l rendition="#et">Hilff/ o Clio/ mit Gesang!</l>
                            <lb/>
                            <pb n="539" facs="4049738"/>
                            <l rendition="#et2">Flora/ mit
                                den guldnen Kle/</l>
                            <lb/>
                            <l rendition="#et2">ziere meine Dorothe.</l>
                            <lb/>
                            <l>in den balden Fru&#x364;hlings-tagen</l>
                            <lb/>
                            <l n="40">die den Wintergreis verjagen.</l>
                        </lg>
                        <lb/>
                    </lg>
                </div>
                <div>
                    <head rendition="#b #c">Grabschrifften.</head>
                    <lb/>
                </div>
                <div n="2" xml:id="n214">
                    <head rendition="#b #c">142. Klingendes Traur- und Trostgeticht: über
                            <lb/>Herren <rs type="person" key="person_168">D. Zwingers</rs> zu <rs
                                type="place" key="place_002">Basel</rs>/ seliges
                            <lb/>Absterben.</head>
                    <lb/>
                    <lg type="poem">
                        <l><hi rendition="#larger"><rs type="person" key="person_168">Herr
                                    Zwinger</rs></hi> zwang den Tod/ von dem er schin gezwungen</l>
                        <lb/>
                        <l rendition="#et">alß ihn derselbige/ gleich andern/ weggerafft/</l>
                        <lb/>
                        <l rendition="#et">er aber von dem Tod/ durch wahren Glaubens krafft/</l>
                        <lb/>
                        <l>nach ritterlichem Kampf/ ins Leben durchgetrungen</l>
                        <lb/>
                        <l n="5">Sein’ edle Seele sich hat u&#x364;ber sich geschwungen</l>
                        <lb/>
                        <l rendition="#et">in jennes Ort/ wo sie in stäten freüden lebt/</l>
                        <lb/>
                        <l rendition="#et">erwartend ihres Leibs/ des Schöpfers Lob erhebt/</l>
                        <lb/>
                        <l>und stimmet mit/ wann wird das Heilig Herr/ gesungen.</l>
                        <lb/>
                        <l>Ihr Hinterlaßne laßt nun euer Trauren fahren/</l>
                        <lb/>
                        <l n="10" rendition="#et"><hi rendition="#larger">Herr <rs type="person"
                                    key="person_168">Zwinger</rs></hi> wünscht nicht mehr in diser
                            Welt zuseyn/</l>
                        <lb/>
                        <l rendition="#et">wo lauter zwang und drang/ sorg/ mu&#x364;h’ und seelen
                            peyn:</l>
                        <lb/>
                        <l>des Trostes Gottes eüch wöll vor weiterm Leid bewahren!</l>
                        <lb/>
                        <l rendition="#et">O/ daß ein gleicher Hirt der hinterlaßnen Herd/</l>
                        <lb/>
                        <l rendition="#et">in stäter Wolffsgefahr/ bald fürgesetzet werd!</l>
                    </lg>
                    <lb/>
                </div>
                <div n="2" xml:id="n215">
                    <head rendition="#b #c">143. Auf Herren <rs type="person" key="person_169"
                                >Joh. Jakob Genathen</rs>/ beru&#x364;hm<lb break="no"/>ten Trukker
                            und Bu&#x366;chhändlers in <rs type="place" key="place_002">Basel</rs>/
                            <lb/>Begräbnus.</head>
                    <lb/>
                    <lg type="poem">
                        <l>Nun ists mit Ihm gethan; nun fahrt Er hin im Friden;</l>
                        <lb/>
                        <l>doch ist sein guter Namm von uns nicht abgeschiden:</l>
                        <lb/>
                        <l rendition="#et">die weitbekante Preß/ durch die ein Mann mehr
                            schreibt</l>
                        <lb/>
                        <l rendition="#et">eins Tags alß sonst ein Jahr/ macht daß Er ewig
                            bleibt.</l>
                    </lg>
                    <lb/>
                </div>
                <pb n="540" facs="4049739"/>
                <div n="2" xml:id="n216">
                    <head rendition="#b #c">144. Sonnet/ <lb/>oder <lb/>Trauriger Todtenklang/
                            <lb/>über <lb/>Herren Lands-Haubtmann <rs type="person" key="person_003"
                                >Meinrad <lb/>Buolen</rs>/ ihme seliges; dem Vatterland<lb/>
                            höchstschädliches Ab<lb break="no"/>leiben.</head>
                    <lb/>
                    <lg type="poem">
                        <l><hi rendition="#larger">Ach!</hi> armes <hi rendition="#larger"
                                >Vatterland!</hi> des <rs type="person" key="person_003"><hi
                                    rendition="#larger">Vatters</hi></rs> nun beraubet</l>
                        <lb/>
                        <l rendition="#et"><anchor xml:id="k216.2"/>durch den/ der allem fleisch<note type="annotation" targetEnd="k216.2"><p>d. i. der Tod (auch die folgenden Verse)</p></note> versaget <anchor xml:id="k216.5"/>Audientz<note type="annotation" targetEnd="k216.5"><p>‹Gehör, Anhörung›: der Tod hört keine Bitte an, <ref target="https://fwb-online.de/lemma/audienz.s.1f">FWB</ref></p></note>/</l>
                        <lb/>
                        <l rendition="#et">bey welchem weder Bitt/ noch Goldgeleiches Gläntz/</l>
                        <lb/>
                        <l>noch auch die Tugend gilt; dieweil er keinem glaubet/</l>
                        <lb/>
                        <l n="5">und ihm der <hi rendition="#larger">Schöpfer</hi> selb das Würgen
                            hat erlaubet:</l>
                        <lb/>
                        <l rendition="#et">Es mag ein König seyn/ in einem Purpur-Rok/</l>
                        <lb/>
                        <l rendition="#et">Ein Bättler an der Straß/ auff halb verfaultem Stok/</l>
                        <lb/>
                        <l>ein weiser oder thor/ er frißts unaußgeklaubet/</l>
                        <lb/>
                        <l rendition="#et">doch nur das Sterbliche/ Herrn <rs type="person"
                                key="person_003">Buolen</rs> Seele lebt/</l>
                        <lb/>
                        <l n="10" rendition="#et">und/ selig/ Gottes Lob im Himmel hoch erhebt/</l>
                        <lb/>
                        <l>erwartend auch des Leibs. <anchor xml:id="k216.3"/>Die Ehrgedächtnuß<note type="annotation" targetEnd="k216.3"><p>der feminine Artikel im Fnhd. nicht ungewöhnlich, <ref target="https://fwb-online.de/lemma/ged%C3%A4chtnis.s.1f">FWB</ref></p></note> bleibet/</l>
                        <lb/>
                        <l rendition="#et">sein weltbekantes Lob verschwindet nimmermehr/</l>
                        <lb/>
                        <l rendition="#et">wo seiner wird gedacht/ <anchor xml:id="k216.4"/>beschihets<note type="annotation" targetEnd="k216.4"><p>von ‹beschehen›, <ref target="https://www.dwds.de/wb/dwb/beschehen">DWDS</ref>, d. i. ‹geschehen›</p></note> nur in ehr/</l>
                        <lb/>
                        <l>so/ daß der Ewigkeit sein Namm bleibt eynverleibet.</l>
                    </lg>
                    <lb/>
                </div>
  </div>
  </body>
  </text>
